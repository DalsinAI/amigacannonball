    (abort "Cannonball needs Installer 43.3 or newer. This one is older: install AmigaOS 3.2 or a newer Installer."))
(set #cpu (database "cpu"))
(if (not (or (= #cpu "68040") (= #cpu "68060") (= #cpu "68080")))
    (abort (cat "Cannonball needs a 68040, 68060 or 68080 with an FPU. This Amiga has a " #cpu ".")))
(if (= (database "fpu") "NOFPU")
    (abort "Cannonball needs a 68040, 68060 or 68080 with an FPU. This Amiga has no FPU."))

; the package: the drawer beside this script
(set #source (pathonly (expandpath @icon)))
(set #from (tackon #source #drawer))
(if (<> (exists #from (noreq)) 2)
    (abort "The Cannonball drawer is not beside Install-Cannonball. Unpack the whole archive, then run Install-Cannonball from there."))
(if (<> (exists (tackon #from #program) (noreq)) 1)
    (abort "The Cannonball drawer has no Cannonball in it. Unpack the whole archive again."))

(welcome "This installs Cannonball 0.35-gfos1 for AmigaOS 3.2 on a 68040, 68060 or 68080 with an FPU.")

