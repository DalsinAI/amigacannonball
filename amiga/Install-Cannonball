                        (help @copyfiles-help)
                        (source #src)
                        (dest #into2)
                        (choices "epr-10380.133" "epr-10382.118" "epr-10381.132" "epr-10383.117" "epr-10327.76" "epr-10329.58" "epr-10328.75" "epr-10330.57")
                        (optional "nofail" "force")))
            )
        )
        (if (= #how 1)
            (set #later (if (= #later "") "your own Japanese OutRun ROMs (other tracks)" (cat #later ", " "your own Japanese OutRun ROMs (other tracks)")))
        )
    )
)
(complete 90)

(set @default-dest #dest)
(complete 100)
(if @pretend
    (message (cat "Pretend: nothing was copied or changed. Cannonball would have gone in " #dest "."))
    (message (cat "Cannonball 0.35-gfos1 is installed in " #dest "."
                  "\n\nTo start it, open the Cannonball drawer and double-click the Cannonball icon."
                  (if (= #kept "") "" (cat "\n\nLeft as they were: " #kept "."))
                  (if (= #later "") "" (cat "\n\nStill to add to the drawer: " #later ". Run Install-Cannonball again to fetch or copy it.")))))
(exit (quiet))
